export ZOPEN_BUILD_LINE="DEV"
export ZOPEN_DEV_URL="https://github.com/ZOSOpenTools/libdio.git"
export ZOPEN_DEV_DEPS="make cjson coreutils diffutils check_python metaldio"
export ZOPEN_MAKE_MINIMAL=Y
export ZOPEN_MAKE="zopen_build"
export ZOPEN_CHECK_MINIMAL=Y
export ZOPEN_CHECK="zopen_check"
export ZOPEN_INSTALL_OPTS="install PREFIX=\$ZOPEN_INSTALL_DIR"
export ZOPEN_COMP="skip"

export ZOPEN_RUNTIME_DEPS="metaldio cjson"

export ZOPEN_CONFIGURE="skip"

zopen_init()
{
  export CJSON_INCLUDE_DIR=$CJSON_HOME/include/
  export CJSON_LIBRARY=$CJSON_HOME/lib/libcjson.a
  export METALDIO_INCLUDE_DIR=$METALDIO_HOME/include/metaldio
  export METALDIO_LIBRARY=$METALDIO_HOME/lib
}

zopen_build() 
{
  export PATH=/nfsmnts/bpidrivers/zosv2r4/dataset/:$PATH
  make 
}

zopen_check() 
{
  unset LDFLAGS_FOR_BUILD
  unset LDFLAGS
  export PATH=/nfsmnts/bpidrivers/zosv2r4/dataset/:$PATH
  make  check
}

# Avoid zoslib
export ZOPEN_DONT_ADD_ZOSLIB_DEP=1

export ZOPEN_CATEGORIES="development core"

#TODO:
zopen_check_results()
{
  dir="$1"
  pfx="$2"
  chk="$1/$2_check.log"

  # Echo the following information to gauge build health
  echo "actualFailures:0"
  echo "totalTests:1"
  echo "expectedFailures:0"
  echo "expectedTotalTests:1"
}

zopen_append_to_env()
{
cat <<ZZ
if [ ! -z "\$ZOPEN_IN_ZOPEN_BUILD" ]; then
  export ZOPEN_EXTRA_CFLAGS="\${ZOPEN_EXTRA_CFLAGS} -I\$PWD/include"
  export ZOPEN_EXTRA_CXXFLAGS="\${ZOPEN_EXTRA_CXXFLAGS} -I\$PWD/include"
  export ZOPEN_EXTRA_LDFLAGS="\${ZOPEN_EXTRA_LDFLAGS} -L\$PWD/lib"
  export ZOPEN_EXTRA_LIBS="\${ZOPEN_EXTRA_LIBS} -lbpamiosvcs -lbpamiocore -ldio"
fi
ZZ
}

zopen_get_version()
{
  echo "0.1.0"
}
